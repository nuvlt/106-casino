# Railway Postgres
DATABASE_URL=
DIRECT_DATABASE_URL=

# Railway Redis
REDIS_URL=

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Erişim kontrolü
ALLOWED_DOMAIN=106dijital.com
ADMIN_EMAILS=onur@106dijital.com

# Vercel Cron uçlarını korumak için
CRON_SECRET=

TZ=Europe/Istanbul

# --- Yerel geliştirme (Railway olmadan) ---
# Gömülü Postgres (WASM) — hiçbir sunucu kurmaya gerek yok.
#   pglite://memory   → bellekte, her açılışta temiz (önerilen)
#   pglite://.pglite  → diske yazar, sunucuyu düzgün kapatmak gerekir
# DATABASE_URL=pglite://memory
# DEV_LOGIN=1   → /api/dev/login ile Google'sız giriş (sadece localhost)
